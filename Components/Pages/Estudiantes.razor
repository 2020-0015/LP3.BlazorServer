@page "/estudiantes"
@rendermode InteractiveServer

@using LP3.BlazorServer.Shared.DTOs
@using LP3.BlazorServer.Application.Services
@using LP3.BlazorServer.Domain.Enums

@inject IEstudianteService EstudianteService

<div class="students-page">

    <section class="hero-section">
        <div>
            <span class="hero-badge">Panel académico</span>
            <h1>Gestión de Estudiantes</h1>
            <p>
                Administra el registro, búsqueda, edición y eliminación de estudiantes
                desde una interfaz clara y organizada.
            </p>
        </div>

        <div class="hero-counter">
            <span>@(estudiantes?.Count ?? 0)</span>
            <small>Estudiantes registrados</small>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(mensajeRegistro))
    {
        <div class="custom-alert @(mensajeRegistro.StartsWith("✅") ? "success" : mensajeRegistro.StartsWith("⚠️") ? "warning" : "danger")">
            @mensajeRegistro
        </div>
    }

    <section class="content-grid">

        <!-- Buscar estudiante -->
        <div class="modern-card search-card">
            <div class="card-header-custom">
                <div class="icon-circle blue">🔍</div>
                <div>
                    <h3>Buscar estudiante</h3>
                    <p>Consulta un estudiante usando su matrícula.</p>
                </div>
            </div>

            <div class="search-box">
                <input type="text"
                       class="form-control custom-input"
                       @bind="matriculaBusqueda"
                       placeholder="Ej: 2024001" />

                <button class="btn-main"
                        @onclick="BuscarPorMatricula">
                    Buscar
                </button>
            </div>

            @if (estudianteBuscado != null)
            {
                <div class="student-result">
                    <div class="avatar">
                        @estudianteBuscado.Nombre?[0]
                    </div>

                    <div>
                        <strong>
                            @estudianteBuscado.Nombre @estudianteBuscado.Apellido
                        </strong>
                        <span>
                            ID: @estudianteBuscado.Id · Matrícula:
                            @estudianteBuscado.Matricula
                        </span>
                    </div>
                </div>
            }
        </div>

        <!-- Registrar estudiante -->
        <div class="modern-card">
            <div class="card-header-custom">
                <div class="icon-circle green">➕</div>
                <div>
                    <h3>Registrar nuevo estudiante</h3>
                    <p>Completa los datos básicos del estudiante.</p>
                </div>
            </div>

            <EditForm FormName="registroEstudianteForm"
                      Model="nuevoEstudiante"
                      OnValidSubmit="RegistrarEstudiante">

                <DataAnnotationsValidator />
                <ValidationSummary class="validation-box" />

                <div class="form-grid">
                    <div class="form-group-custom">
                        <label for="nombre">Nombre</label>
                        <InputText id="nombre"
                                   @bind-Value="nuevoEstudiante.Nombre"
                                   class="form-control custom-input"
                                   placeholder="Ej: Juan" />
                    </div>

                    <div class="form-group-custom">
                        <label for="apellido">Apellido</label>
                        <InputText id="apellido"
                                   @bind-Value="nuevoEstudiante.Apellido"
                                   class="form-control custom-input"
                                   placeholder="Ej: Pérez" />
                    </div>

                    <div class="form-group-custom full-width">
                        <label for="matricula-new">Matrícula</label>
                        <InputText id="matricula-new"
                                   @bind-Value="nuevoEstudiante.Matricula"
                                   class="form-control custom-input"
                                   placeholder="Ej: 2024001" />
                    </div>
                </div>

                <button type="submit" class="btn-save">
                    Guardar estudiante
                </button>

            </EditForm>
        </div>

    </section>

    <!-- Estudiantes registrados -->
    <section class="modern-card table-card">

        <div class="table-title">
            <div>
                <h3>Estudiantes registrados</h3>
                <p>Listado general de estudiantes guardados en el sistema.</p>
            </div>

            <span class="count-pill">
                @(estudiantes?.Count ?? 0) registros
            </span>
        </div>

        @if (estudiantes == null || estudiantes.Count == 0)
        {
            <div class="empty-state">
                <div>📭</div>
                <h4>No hay estudiantes registrados</h4>
                <p>Cuando registres estudiantes, aparecerán en esta tabla.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table modern-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre completo</th>
                            <th>Matrícula</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var est in estudiantes ?? [])
                        {
                            <tr>
                                <td>
                                    <span class="id-badge">@est.Id</span>
                                </td>

                                <td>
                                    <div class="student-name">
                                        <div class="mini-avatar">
                                            @est.Nombre?[0]
                                        </div>

                                        <div>
                                            <strong>@est.Nombre @est.Apellido</strong>
                                            <small>Estudiante registrado</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="matricula-badge">
                                        @est.Matricula
                                    </span>
                                </td>

                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-edit"
                                                @onclick="() => CargarParaEditar(est)">
                                            Editar
                                        </button>

                                        <button class="btn-delete"
                                                @onclick="() => ConfirmarEliminar(est.Id)">
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </section>

    <!-- Editar estudiante -->
    @if (editandoEstudiante != null)
    {
        <section class="modern-card edit-card">

            <div class="card-header-custom">
                <div class="icon-circle orange">✏️</div>
                <div>
                    <h3>Editar estudiante</h3>
                    <p>Modifica los datos permitidos del estudiante seleccionado.</p>
                </div>
            </div>

            <EditForm FormName="editarEstudianteForm"
                      Model="editandoEstudiante"
                      OnValidSubmit="GuardarCambios">

                <DataAnnotationsValidator />
                <ValidationSummary class="validation-box" />

                <div class="form-grid">
                    <div class="form-group-custom">
                        <label for="nombre-edit">Nombre</label>
                        <InputText id="nombre-edit"
                                   @bind-Value="editandoEstudiante.Nombre"
                                   class="form-control custom-input" />
                    </div>

                    <div class="form-group-custom">
                        <label for="apellido-edit">Apellido</label>
                        <InputText id="apellido-edit"
                                   @bind-Value="editandoEstudiante.Apellido"
                                   class="form-control custom-input" />
                    </div>

                    <div class="form-group-custom full-width">
                        <label for="matricula-edit">Matrícula</label>
                        <InputText id="matricula-edit"
                                   @bind-Value="editandoEstudiante.Matricula"
                                   class="form-control custom-input"
                                   disabled />
                        <small class="input-help">
                            La matrícula no se puede modificar.
                        </small>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-save">
                        Guardar cambios
                    </button>

                    <button type="button"
                            class="btn-cancel"
                            @onclick="CancelarEdicion">
                        Cancelar
                    </button>
                </div>

            </EditForm>

        </section>
    }

    <!-- Confirmar eliminación -->
    @if (mostrarConfirmacionEliminar)
    {
        <section class="delete-overlay">
            <div class="delete-modal">

                <div class="delete-icon">⚠️</div>

                <h3>Confirmar eliminación</h3>

                <p>
                    ¿Estás seguro de que deseas eliminar este estudiante?
                    Esta acción no se puede deshacer.
                </p>

                <div class="delete-actions">
                    <button class="btn-delete-confirm"
                            @onclick="EliminarEstudiante">
                        Sí, eliminar
                    </button>

                    <button class="btn-cancel"
                            @onclick="CancelarEliminar">
                        Cancelar
                    </button>
                </div>

            </div>
        </section>
    }

</div>

