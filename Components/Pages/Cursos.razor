@page "/cursos"
@rendermode InteractiveServer

@using LP3.BlazorServer.Shared.DTOs
@using LP3.BlazorServer.Application.Services
@using Microsoft.AspNetCore.Components.Forms

@inject ICursoService CursoService

<div class="courses-page">

    <section class="hero-section">
        <div>
            <span class="hero-badge">Panel académico</span>
            <h1>Gestión de Cursos</h1>
            <p>
                Crea, consulta, edita y elimina cursos de forma clara, rápida y organizada.
            </p>
        </div>

        <div class="hero-stats">
            <div>
                <strong>@cursos.Count</strong>
                <span>Cursos registrados</span>
            </div>

            <div>
                <strong>@cursos.Count(c => c.Activo)</strong>
                <span>Activos</span>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(mensajeRegistro))
    {
        <div class="custom-alert @(mensajeRegistro.StartsWith("✅") ? "success" : mensajeRegistro.StartsWith("⚠️") ? "warning" : "danger")">
            @mensajeRegistro
        </div>
    }

    <section class="content-grid">

        <!-- Buscar curso -->
        <div class="modern-card search-card">
            <div class="card-header-custom">
                <div class="icon-circle blue">🔍</div>

                <div>
                    <h3>Buscar curso</h3>
                    <p>Consulta un curso usando su código.</p>
                </div>
            </div>

            <div class="search-box">
                <input type="text"
                       class="form-control custom-input"
                       @bind="codigoBusqueda"
                       placeholder="Ej: IRI-005" />

                <button class="btn-main"
                        @onclick="BuscarPorCodigo">
                    Buscar
                </button>
            </div>

            @if (cursoBuscado != null)
            {
                <div class="course-result">
                    <div class="course-avatar">
                        @GetInicial(cursoBuscado.Nombre)
                    </div>

                    <div class="course-result-info">
                        <strong>@cursoBuscado.Nombre</strong>

                        <span>
                            Código: @cursoBuscado.Codigo ·
                            Créditos: @cursoBuscado.Creditos ·
                            Estado: @(cursoBuscado.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>
                </div>
            }
        </div>

        <!-- Registrar curso -->
        <div class="modern-card">
            <div class="card-header-custom">
                <div class="icon-circle green">➕</div>

                <div>
                    <h3>Registrar nuevo curso</h3>
                    <p>Completa la información básica del curso.</p>
                </div>
            </div>

            <EditForm FormName="registroCursoForm"
                      Model="nuevoCurso"
                      OnValidSubmit="RegistrarCurso">

                <DataAnnotationsValidator />
                <ValidationSummary class="validation-box" />

                <div class="form-grid">
                    <div class="form-group-custom">
                        <label for="nombre-new">Nombre</label>

                        <InputText id="nombre-new"
                                   @bind-Value="nuevoCurso.Nombre"
                                   class="form-control custom-input"
                                   placeholder="Ej: Introducción a la Programación" />
                    </div>

                    <div class="form-group-custom">
                        <label for="codigo-new">Código</label>

                        <InputText id="codigo-new"
                                   @bind-Value="nuevoCurso.Codigo"
                                   class="form-control custom-input"
                                   placeholder="Ej: IRI-005" />
                    </div>

                    <div class="form-group-custom">
                        <label for="creditos-new">Créditos</label>

                        <InputNumber id="creditos-new"
                                     @bind-Value="nuevoCurso.Creditos"
                                     class="form-control custom-input" />
                    </div>

                    <div class="form-group-custom">
                        <label>Estado</label>

                        <label class="status-toggle">
                            <InputCheckbox id="activo-new"
                                           @bind-Value="nuevoCurso.Activo"
                                           class="toggle-input" />

                            <span class="toggle-slider"></span>

                            <span class="toggle-text">
                                Curso activo
                            </span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn-save">
                    Guardar curso
                </button>

            </EditForm>
        </div>

    </section>

    <!-- Listado de cursos -->
    <section class="modern-card table-card">

        <div class="table-title">
            <div>
                <h3>Cursos registrados</h3>
                <p>Listado general de cursos guardados en el sistema.</p>
            </div>

            <span class="count-pill">
                @cursos.Count registros
            </span>
        </div>

        @if (cursos.Count == 0)
        {
            <div class="empty-state">
                <div>📭</div>
                <h4>No hay cursos registrados</h4>
                <p>Cuando registres cursos, aparecerán en esta tabla.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table modern-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Curso</th>
                            <th>Código</th>
                            <th>Créditos</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var curso in cursos)
                        {
                            <tr>
                                <td>
                                    <span class="id-badge">@curso.Id</span>
                                </td>

                                <td>
                                    <div class="course-name">
                                        <div class="mini-avatar">
                                            @GetInicial(curso.Nombre)
                                        </div>

                                        <div>
                                            <strong>@curso.Nombre</strong>
                                            <small>Curso académico</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="code-badge">
                                        @curso.Codigo
                                    </span>
                                </td>

                                <td>
                                    <span class="credits-badge">
                                        @curso.Creditos créditos
                                    </span>
                                </td>

                                <td>
                                    @if (curso.Activo)
                                    {
                                        <span class="status-badge active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-edit"
                                                @onclick="() => CargarParaEditar(curso)">
                                            Editar
                                        </button>

                                        <button class="btn-delete"
                                                @onclick="() => ConfirmarEliminar(curso.Id)">
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </section>

    <!-- Editar curso -->
    @if (editandoCurso != null)
    {
        <section class="modern-card edit-card">

            <div class="card-header-custom">
                <div class="icon-circle orange">✏️</div>

                <div>
                    <h3>Editar curso</h3>
                    <p>Modifica los datos del curso seleccionado.</p>
                </div>
            </div>

            <EditForm FormName="editarCursoForm"
                      Model="editandoCurso"
                      OnValidSubmit="GuardarCambios">

                <DataAnnotationsValidator />
                <ValidationSummary class="validation-box" />

                <div class="form-grid">
                    <div class="form-group-custom">
                        <label for="nombre-edit">Nombre</label>

                        <InputText id="nombre-edit"
                                   @bind-Value="editandoCurso.Nombre"
                                   class="form-control custom-input" />
                    </div>

                    <div class="form-group-custom">
                        <label for="codigo-edit">Código</label>

                        <InputText id="codigo-edit"
                                   @bind-Value="editandoCurso.Codigo"
                                   class="form-control custom-input" />
                    </div>

                    <div class="form-group-custom">
                        <label for="creditos-edit">Créditos</label>

                        <InputNumber id="creditos-edit"
                                     @bind-Value="editandoCurso.Creditos"
                                     class="form-control custom-input" />
                    </div>

                    <div class="form-group-custom">
                        <label>Estado</label>

                        <label class="status-toggle">
                            <InputCheckbox id="activo-edit"
                                           @bind-Value="editandoCurso.Activo"
                                           class="toggle-input" />

                            <span class="toggle-slider"></span>

                            <span class="toggle-text">
                                Curso activo
                            </span>
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-save">
                        Guardar cambios
                    </button>

                    <button type="button"
                            class="btn-cancel"
                            @onclick="CancelarEdicion">
                        Cancelar
                    </button>
                </div>

            </EditForm>

        </section>
    }

    <!-- Confirmación de eliminación -->
    @if (mostrarConfirmacionEliminar)
    {
        <section class="delete-overlay">
            <div class="delete-modal">

                <div class="delete-icon">⚠️</div>

                <h3>Confirmar eliminación</h3>

                <p>
                    ¿Estás seguro de que deseas eliminar este curso?
                    Esta acción no se puede deshacer.
                </p>

                <div class="delete-actions">
                    <button class="btn-delete-confirm"
                            @onclick="EliminarCurso">
                        Sí, eliminar
                    </button>

                    <button class="btn-cancel"
                            @onclick="CancelarEliminar">
                        Cancelar
                    </button>
                </div>

            </div>
        </section>
    }

</div>

